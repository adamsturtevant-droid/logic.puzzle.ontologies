                                        <owl:someValuesFrom>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#likesEvent"/>
                                                <owl:hasValue rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Poles"/>
                                            </owl:Restriction>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:someValuesFrom>
