    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Beany -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Beany">
        <rdf:type rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Dog"/>
    </owl:NamedIndividual>
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NegativePropertyAssertion"/>
        <owl:sourceIndividual rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Beany"/>
        <owl:assertionProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#likesEvent"/>
        <owl:targetIndividual rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Tunnel"/>
    </rdf:Description>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Boxer -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Boxer">
        <rdf:type rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Breed"/>
        <rdf:type>
            <owl:Class>
                <owl:complementOf>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#isBreedOf"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#likesEvent"/>
                                <owl:hasValue rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Tire"/>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:complementOf>
            </owl:Class>
        </rdf:type>
        <rdf:type>
            <owl:Class>
                <owl:complementOf>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#isBreedOf"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#likesEvent"/>
                                <owl:hasValue rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Tunnel"/>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:complementOf>
            </owl:Class>
        </rdf:type>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#isBreedOf"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#hasRank"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#isOnePlaceBehind"/>
                                <owl:someValuesFrom>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#isRankOf"/>
                                        <owl:someValuesFrom>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#hasBreed"/>
                                                <owl:hasValue rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Shepherd"/>
                                            </owl:Restriction>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdf:type>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Cheetah -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Cheetah">
        <rdf:type rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Dog"/>
        <rdf:type>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#hasRank"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#4"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#likesEvent"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Tunnel"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdf:type>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#hasRank"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:oneOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#1"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#3"/>
                        </owl:oneOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdf:type>
    </owl:NamedIndividual>
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NegativePropertyAssertion"/>
        <owl:sourceIndividual rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Cheetah"/>
        <owl:assertionProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#likesEvent"/>
        <owl:targetIndividual rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Poles"/>
    </rdf:Description>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Collie -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Collie">
        <rdf:type rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Breed"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Plank -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Plank">
