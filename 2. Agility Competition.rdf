    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Poles -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Poles">
        <rdf:type rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Event"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#likedBy"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#hasRank"/>
                                <owl:hasValue rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#1"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#hasRank"/>
                                <owl:hasValue rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#3"/>
