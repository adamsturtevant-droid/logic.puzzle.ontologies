<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5/"
     xml:base="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#hasBreed -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#hasBreed">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#isBreedOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Dog"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Breed"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#hasRank -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#hasRank">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#isRankOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Dog"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Rank"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#isBreedOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#isBreedOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Breed"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Dog"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#isOnePlaceBehind -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#isOnePlaceBehind">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Rank"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Rank"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#isRankOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#isRankOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Rank"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Dog"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#likedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#likedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#likesEvent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Event"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Dog"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#likesEvent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#likesEvent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Dog"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Event"/>
    </owl:ObjectProperty>
    


    <!-- 
