     -->

    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Breed -->

    <owl:Class rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Breed">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Boxer"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Collie"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Shepherd"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Terrier"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#isBreedOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Dog"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Dog -->

    <owl:Class rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Dog">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Beany"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Cheetah"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Suzie"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Thor"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#hasBreed"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Breed"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#hasRank"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Rank"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#likesEvent"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Event"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Event -->

    <owl:Class rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Event">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Plank"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Poles"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Tire"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Tunnel"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#likedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Dog"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Rank -->

    <owl:Class rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Rank">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#1"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#2"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#3"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#4"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#isRankOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-5#Dog"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


