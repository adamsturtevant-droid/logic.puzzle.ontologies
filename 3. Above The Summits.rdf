        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-6#climbedBy"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
