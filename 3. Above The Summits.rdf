    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-6#5MoreThan -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-6#5MoreThan">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-6#Days"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-6#Days"/>
    </owl:ObjectProperty>
    


