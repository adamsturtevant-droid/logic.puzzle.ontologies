    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-6#climbedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-6#climbedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-6#climbedMountain"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-6#Mountain"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-6#Explorer"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-6#climbedForDays -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-6#climbedForDays">
