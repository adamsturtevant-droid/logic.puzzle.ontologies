                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Girl_Student"/>
            </owl:Restriction>
        </rdf:type>
    </owl:NamedIndividual>
    


