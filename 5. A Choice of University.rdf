    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Architecture -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Architecture">
        <rdf:type rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Subject"/>
        <rdf:type>
            <owl:Class>
                <owl:complementOf>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#isSubjectOf"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#isFromCountry"/>
                                <owl:hasValue rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Australia"/>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:complementOf>
            </owl:Class>
        </rdf:type>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#isSubjectOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Boy_Student"/>
            </owl:Restriction>
        </rdf:type>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Australia -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Australia">
        <rdf:type rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Country"/>
        <rdf:type>
            <owl:Class>
                <owl:complementOf>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#isCountryOf"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#hasSubject"/>
                                <owl:hasValue rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Architecture"/>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:complementOf>
            </owl:Class>
        </rdf:type>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#isCountryOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Boy_Student"/>
            </owl:Restriction>
        </rdf:type>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Boy_with_same_initial -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Boy_with_same_initial">
        <rdf:type rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Boy_Student"/>
        <rdf:type>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:oneOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Lucas"/>
                                </owl:oneOf>
                            </owl:Class>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#hasCity"/>
                                <owl:hasValue rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#London"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:oneOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Oliver"/>
                                </owl:oneOf>
                            </owl:Class>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#hasCity"/>
                                <owl:hasValue rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Oxford"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </rdf:type>
        <rdf:type>
            <owl:Class>
                <owl:complementOf>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Class>
                                        <owl:oneOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Lucas"/>
                                        </owl:oneOf>
                                    </owl:Class>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#hasCity"/>
                                        <owl:hasValue rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#London"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Class>
                                        <owl:oneOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Oliver"/>
                                        </owl:oneOf>
                                    </owl:Class>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#hasCity"/>
                                        <owl:hasValue rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Oxford"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:complementOf>
            </owl:Class>
        </rdf:type>
        <owl:differentFrom rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Girl_with_same_initial"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Cambridge -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Cambridge">
