     -->

    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Boy_Student -->

    <owl:Class rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Boy_Student">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Boy_with_same_initial"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Lucas"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Oliver"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Student"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Girl_Student"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#City -->

    <owl:Class rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#City">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Cambridge"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Edinburgh"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#London"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Oxford"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#IsCityOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Student"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Country -->

    <owl:Class rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Country">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Australia"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Canada"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#South_Africa"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#USA"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#isCountryOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Student"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Girl_Student -->

    <owl:Class rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Girl_Student">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Carol"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Elisa"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Girl_with_same_initial"/>
                </owl:oneOf>
