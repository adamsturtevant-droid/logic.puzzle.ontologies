    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#IsCityOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#IsCityOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#hasCity"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#City"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Student"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#hasCity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#hasCity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Student"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#City"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#hasSubject -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#hasSubject">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#isSubjectOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Student"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Subject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#isCountryOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#isCountryOf">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#isFromCountry"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Student"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#isFromCountry -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#isFromCountry">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Student"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Country"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#isSubjectOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#isSubjectOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Subject"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-7#Student"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
