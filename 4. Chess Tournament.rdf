    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Player -->

    <owl:Class rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Player">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Bert"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Larry"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Steve"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Tom"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#hasNumber"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Number"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#hasPlace"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Place"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#hasSurname"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Surname"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#usedOpening"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Opening"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Surname -->

    <owl:Class rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Surname">
