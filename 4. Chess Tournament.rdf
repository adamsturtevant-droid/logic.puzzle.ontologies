    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Number -->

    <owl:Class rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Number">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#16"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#31"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#32"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#40"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#isNumberOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Player"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Opening -->

    <owl:Class rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Opening">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Giuoco_Piano"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Kings_Indian"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Queens_Gambit"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/asturtevant/ontologies/2026/8/untitled-ontology-12#Ruy_Lopez"/>
                </owl:oneOf>
            </owl:Class>
